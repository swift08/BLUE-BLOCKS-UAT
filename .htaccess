<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

RewriteEngine On

# --------------------------------------------------
# 1) Force HTTPS + non-www
# --------------------------------------------------
<!-- RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.blueblocks\.in$ [NC]
RewriteRule ^(.*)$ https://blueblocks.in/$1 [R=301,L] -->

# --------------------------------------------------
# 2) Main pages
# --------------------------------------------------
# --------------------------------------------------
RewriteRule ^about-us\.shtml$ https://dev65.blueblocks.in/about-us/ [R=301,L,NC]
RewriteRule ^montessori\.shtml$ https://dev65.blueblocks.in/montessori-system/ [R=301,L,NC]
RewriteRule ^careers\.shtml$ https://dev65.blueblocks.in/careers/ [R=301,L,NC]
RewriteRule ^campus\.shtml$ https://dev65.blueblocks.in/campus/ [R=301,L,NC]
RewriteRule ^faq\.shtml$ https://dev65.blueblocks.in/faq/ [R=301,L,NC]
RewriteRule ^admission\.shtml$ https://dev65.blueblocks.in/admissions/ [R=301,L,NC]
RewriteRule ^programs\.shtml$ https://dev65.blueblocks.in/programs/ [R=301,L,NC]
RewriteRule ^innovation\.shtml$ https://dev65.blueblocks.in/innovation/ [R=301,L,NC]
RewriteRule ^privacy-policy\.shtml$ https://dev65.blueblocks.in/privacy-policy/ [R=301,L,NC]

# --------------------------------------------------
# 3) Program pages
# --------------------------------------------------
RewriteRule ^toddler\.shtml$ https://dev65.blueblocks.in/programs/playgroup/ [R=301,L,NC]
RewriteRule ^self\.shtml$ https://dev65.blueblocks.in/programs/nursery-school/ [R=301,L,NC]
RewriteRule ^elementary\.shtml$ https://dev65.blueblocks.in/programs/primary-school-elementary/ [R=301,L,NC]
RewriteRule ^high\.shtml$ https://dev65.blueblocks.in/programs/secondary-school/ [R=301,L,NC]

# --------------------------------------------------
# 4) Innovation pages
# --------------------------------------------------
RewriteRule ^drone-patent\.shtml$ https://dev65.blueblocks.in/innovation/drone-lab/ [R=301,L,NC]
RewriteRule ^space-program\.shtml$ https://dev65.blueblocks.in/innovation/space-lab/ [R=301,L,NC]
RewriteRule ^biomimicryhive\.shtml$ https://dev65.blueblocks.in/innovation/biomimicry-hive/ [R=301,L,NC]

# --------------------------------------------------
# 5) Legacy/special paths
# --------------------------------------------------
RewriteRule ^Innovation/CubeSat-Mission/?$ https://research.blueblocks.in/publications/CubeSat-INSPACE/ [R=301,L,NC]
RewriteRule ^blog/?$ https://dev65.blueblocks.in/blog/ [R=301,L,NC]

# --------------------------------------------------
# 6) Resolved formerly unmapped items
# --------------------------------------------------
RewriteRule ^positive-parenting\.shtml$ https://dev65.blueblocks.in/parents/ [R=301,L,NC]
RewriteRule ^virtual-learning\.shtml$ https://dev65.blueblocks.in/programs/ [R=301,L,NC]
RewriteRule ^public/resourses/documents/Drone-Innovation-and-Research\.pdf$ https://dev65.blueblocks.in/innovation/drone-lab/ [R=301,L,NC]
RewriteRule ^videos\.shtml$ https://dev65.blueblocks.in/videos/ [R=301,L,NC]
RewriteRule ^schedule-meeting-with-parent-coordinator\.shtml$ https://dev65.blueblocks.in/contact-us/ [R=301,L,NC]
RewriteRule ^schedule-meeting-with-director-elementory\.shtml$ https://dev65.blueblocks.in/admissions/ [R=301,L,NC]
