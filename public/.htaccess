# Section 4 - Founders & team pages
RewriteCond %{HTTP_HOST} ^(www\.)?blueblocks\.in$ [NC]
RewriteRule ^founders/pavan-goyal/?$ https://blueblocks.in/about-us/founders/pavan-goyal/ [R=301,L,NE]

# Specific team-member slug redirects to /about-us/?guide=slug.
# Covers legacy URLs like /team/aishwarya-tejaswiraj/ -> /about-us/?guide=aishwarya-tejaswiraj
RewriteCond %{HTTP_HOST} ^(www\.)?blueblocks\.in$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^team/([^/]+)/?$ https://blueblocks.in/about-us/?guide=$1 [R=301,L,NE]

# Chained/nested /team/* fallbacks (deleted sub-paths or malformed legacy crawl attempts) -> /about-us/
RewriteCond %{HTTP_HOST} ^(www\.)?blueblocks\.in$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^team/.+$ https://blueblocks.in/about-us/ [R=301,L,NE]

